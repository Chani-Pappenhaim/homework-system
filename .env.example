# ===================================================================
# תבנית סביבה. העתק ל־.env:  Copy-Item .env.example .env
# הערכים כאן מוכנים להרצה מקומית עם Docker (localhost). מלא רק את
# מפתחות ה־API שאתה צריך (Gemini / Claude / Cloudinary / OAuth / SMTP).
# ===================================================================

# Database — שמות המשתמש/סיסמה תואמים ל־docker-compose.yml
DATABASE_URL=postgresql://user:pass@postgres:5432/homework_db

# Redis
REDIS_URL=redis://redis:6379

# JWT — החלף במחרוזות אקראיות ארוכות (64+ תווים). הערכים כאן הם דוגמה בלבד
# ומספיקים לפיתוח מקומי; לפרודקשן חובה ליצור ערכים אקראיים חדשים.
JWT_SECRET=CHANGE_ME_local_dev_only_0000000000000000000000000000000000000000
JWT_REFRESH_SECRET=CHANGE_ME_local_dev_refresh_11111111111111111111111111111111

# AI — Google Gemini. ספק ה-AI היחיד: גם בדיקת ההגשות וגם יצירת החידונים.
# GEMINI_MODEL: גוגל מוציאה משימוש מזהי מודלים ותיקים (gemini-2.0-flash כבר
# מוסר ומחזיר 404). לרשימת המודלים הזמינים למפתח שלך:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=<KEY>"
#
# החיוב בגוגל הוא לפי פרויקט, ומפתח יורש את החיוב של הפרויקט שלו — לכן שני מפתחות:
# GEMINI_API_KEY      — מפתח מפרויקט *בלי* חיוב (מסלול חינמי).
# GEMINI_API_KEY_PAID — מפתח מפרויקט *עם* חיוב (רשות). כשהמכסה היומית החינמית נגמרת
#   הקריאות עוברות אליו עד האיפוס (חצות בשעון קליפורניה, ~10:00 בישראל). הגבלות
#   קצרות (לדקה) ותקלות רגעיות לא מעבירות למפתח בתשלום.
# אם מפעילים חיוב על הפרויקט של המפתח הקיים — יש להעביר אותו ל-GEMINI_API_KEY_PAID.
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
GEMINI_MODEL=gemini-3.6-flash

# מספר הבקשות החינמיות ביום (RPD) — רשות, רק לתצוגה בדוח. בלי הערך הדוח מציג את
# המגבלה שגוגל מסרה בפעם האחרונה שהמכסה נגמרה. רואים אותה ב-AI Studio → Rate limits.
GEMINI_FREE_DAILY_LIMIT=

# מחירי טוקנים במסלול בתשלום (ל-1M טוקנים), לדוח העלויות בלבד. ריק = מחירון
# gemini-3.6-flash המובנה בקוד. יש למלא רק כשמחליפים את GEMINI_MODEL.
GEMINI_PRICE_INPUT_PER_1M=
GEMINI_PRICE_OUTPUT_PER_1M=

# Cloudinary — אחסון קבצי הגשה (אם ריק, העלאת קבצים לא תעבוד)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth — GitHub (אופציונלי)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback

# OAuth — Google (אופציונלי)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# OAuth — הפניה לפרונט אחרי התחברות
OAUTH_SUCCESS_REDIRECT=http://localhost/auth/callback

# Email — nodemailer (אם ריק, המערכת רצה אבל לא שולחת מיילים)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@localhost

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost
ADMIN_EMAIL=admin@school.com
