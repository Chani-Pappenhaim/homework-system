# ===================================================================
# תבנית סביבה. העתק ל־.env:  Copy-Item .env.example .env
# הערכים כאן מוכנים להרצה מקומית עם Docker (localhost). מלא רק את
# מפתחות ה־API שאתה צריך (Gemini / Claude / Cloudinary / OAuth / SMTP).
# ===================================================================

# Database — שמות המשתמש/סיסמה תואמים ל־docker-compose.yml
DATABASE_URL=postgresql://user:pass@postgres:5432/homework_db

# Redis
REDIS_URL=redis://redis:6379

# JWT — החלף במחרוזות אקראיות ארוכות (64+ תווים). הערכים כאן הם דוגמה בלבד
# ומספיקים לפיתוח מקומי; לפרודקשן חובה ליצור ערכים אקראיים חדשים.
JWT_SECRET=CHANGE_ME_local_dev_only_0000000000000000000000000000000000000000
JWT_REFRESH_SECRET=CHANGE_ME_local_dev_refresh_11111111111111111111111111111111

# AI — Google Gemini (בדיקת AI של הגשות)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI — Anthropic Claude (יצירת חידונים)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Cloudinary — אחסון קבצי הגשה (אם ריק, העלאת קבצים לא תעבוד)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth — GitHub (אופציונלי)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback

# OAuth — Google (אופציונלי)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# OAuth — הפניה לפרונט אחרי התחברות
OAUTH_SUCCESS_REDIRECT=http://localhost/auth/callback

# Email — nodemailer (אם ריק, המערכת רצה אבל לא שולחת מיילים)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@localhost

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost
ADMIN_EMAIL=admin@school.com
