generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String?
  role                 Role      @default(STUDENT)
  mustChangePassword   Boolean   @default(true)
  githubUsername       String?
  oauthProvider        String?
  oauthId              String?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  // Set once the student follows the link mailed to her address; notification
  // emails only go to verified addresses, so a mistyped or made-up address is
  // never mailed past the verification email itself.
  emailVerifiedAt      DateTime?
  emailVerifyTokenHash String?
  emailVerifyExpiresAt DateTime?
  // Bumped whenever the password changes or is reset; a refresh token signed
  // for an older version stops working, which signs out every other session.
  tokenVersion         Int       @default(0)
  // The student's own choice whether to get notification emails (replies,
  // grades). Starts from her first group's default.
  emailNotifications   Boolean   @default(true)
  createdAt            DateTime  @default(now())

  studentGroups     StudentGroup[]
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  gradesGiven       Grade[]
  lessonAccess      LessonAccess[]
  courseAccess      CourseAccess[]
  lessonProgress    LessonProgress[]
  lessonFileViews   LessonFileView[]
  teacherMessages   TeacherMessage[]
  attendance        AttendanceRecord[]
  homeworkMarks     HomeworkMark[]
  attendanceOptOuts AttendanceExclusion[]
}

model Group {
  id                        String   @id @default(uuid())
  name                      String
  seminar                   String?
  year                      String
  // Whether students added to this group start with notification emails on.
  emailNotificationsDefault Boolean  @default(true)
  createdAt                 DateTime @default(now())

  students StudentGroup[]
  courses  Course[]
}

model StudentGroup {
  studentId String
  groupId   String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([studentId, groupId])
}

model Course {
  id          String   @id @default(uuid())
  name        String
  year        String?
  description String?
  imageUrl    String?
  hidden      Boolean  @default(false)
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])
  createdAt   DateTime @default(now())

  lessons Lesson[]
  links   CourseLink[]
  files   CourseFile[]
  access  CourseAccess[]

  attendanceSessions   AttendanceSession[]
  attendanceExclusions AttendanceExclusion[]
}

model CourseLink {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  label    String
  url      String
  order    Int    @default(0)
}

model CourseFile {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name       String
  url        String
  sizeBytes  BigInt?
  uploadedAt DateTime @default(now())
  // Hidden from students; the teacher still sees it.
  hidden     Boolean  @default(false)
}

model Lesson {
  id         String    @id @default(uuid())
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic      String
  lessonDate DateTime?
  contentMd  String?
  githubUrl  String?
  githubUrls String[]  @default([])
  hidden     Boolean   @default(false)
  order      Int       @default(0)
  createdAt  DateTime  @default(now())

  assignments  Assignment[]
  files        LessonFile[]
  quiz         Quiz?
  lessonAccess LessonAccess[]
  progress     LessonProgress[]

  attendanceSessions AttendanceSession[]
}

// A student's self-marked completion of a lesson (presence of row = completed)
model LessonProgress {
  studentId   String
  lessonId    String
  completedAt DateTime @default(now())
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([studentId, lessonId])
}

// Grants a specific student access to a single lesson outside her group
model LessonAccess {
  studentId String
  lessonId  String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([studentId, lessonId])
}

// A student let into a whole course outside its group — a private student, or
// one following a single course of another class.
model CourseAccess {
  studentId String
  courseId  String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([studentId, courseId])
}

model LessonFile {
  id         String   @id @default(uuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name       String
  url        String
  sizeBytes  BigInt?
  uploadedAt DateTime @default(now())
  required   Boolean  @default(false)
  // Hidden from students; the teacher still sees it.
  hidden     Boolean  @default(false)

  views LessonFileView[]
}

// A student's self-marked "seen/read" of a required file (presence of row = viewed)
model LessonFileView {
  studentId String
  fileId    String
  viewedAt  DateTime   @default(now())
  student   User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  file      LessonFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([studentId, fileId])
}

model Assignment {
  id             String    @id @default(uuid())
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  deadline       DateTime?
  allowedTypes   String[]  @default([])
  allowGithub    Boolean   @default(true)
  allowFile      Boolean   @default(true)
  requirements   Json?
  aiInstructions String?
  createdAt      DateTime  @default(now())

  submissions Submission[]
}

model Submission {
  id             String     @id @default(uuid())
  assignmentId   String
  studentId      String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl        String?
  fileName       String?
  githubUrl      String?
  notes          String?
  checklist      Json? // student's filled copy of the assignment requirements
  submittedAt    DateTime   @default(now())
  isLate         Boolean    @default(false)
  aiStatus       String     @default("none")
  aiScore        Float?
  aiCodeReview   String?
  aiVerbalReview String?
  aiApproved     Boolean    @default(false)
  aiReviewCount  Int        @default(0)
  aiExtraAllowed Boolean    @default(false)
  aiError        String? // Hebrew, shown to the student when aiStatus is 'error'; the technical cause is only logged

  grade Grade?

  @@unique([assignmentId, studentId])
}

model Grade {
  id              String     @id @default(uuid())
  submissionId    String     @unique
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionScore Float?     @default(100) // ציון הגשה — אוטומטי (100 − איחור − checklist)
  contentScore    Float? // ציון תוכן — מ-AI/מורה, מוסתר עד contentApproved
  contentApproved Boolean    @default(false) // מורה אישרה שהציון גלוי לתלמידה (כל הגשה, לא רק AI)
  feedback        String?
  checklist       Json?
  gradedAt        DateTime   @default(now())
  gradedById      String? // null = ציון הגשה אוטומטי שנוצר בזמן ההגשה
  gradedBy        User?      @relation(fields: [gradedById], references: [id])
}

model AiUsageLog {
  id           String   @id @default(uuid())
  type         String
  tokensInput  Int
  tokensOutput Int
  costUsd      Float
  createdAt    DateTime @default(now())
}

// A conversation between one student and the teacher. The actual messages
// live in `entries`, so either side can keep replying indefinitely instead
// of being limited to a single message + a single reply.
model TeacherMessage {
  id           String         @id @default(uuid())
  studentId    String
  student      User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String? // אם קיים → בקשת הגשה מאוחרת למטלה ספציפית
  createdAt    DateTime       @default(now())
  entries      MessageEntry[]
}

model MessageEntry {
  id          String         @id @default(uuid())
  messageId   String
  message     TeacherMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fromTeacher Boolean // true = the teacher wrote this entry, false = the student did
  content     String
  isRead      Boolean        @default(false) // has the other side seen this entry?
  createdAt   DateTime       @default(now())

  @@index([messageId])
}

model Quiz {
  id        String   @id @default(uuid())
  lessonId  String   @unique
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Json
  // A quiz starts as a draft only the teacher can see. Students get it once she
  // has reviewed the AI's questions and published it, so nobody can sit an exam
  // that is mid-edit.
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  attempts QuizAttempt[]
}

model QuizAttempt {
  id         String   @id @default(uuid())
  quizId     String
  studentId  String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    Json
  score      Float
  takenAt    DateTime @default(now())
  // The first attempt per student is locked in as the official grade; every
  // later retry is practice only and never overwrites it (see quizzes.service.ts).
  isOfficial Boolean  @default(true)

  @@index([quizId, studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

// One meeting of a course. Linked to a lesson on the site, or standing on its
// own for a meeting that happened in class only (then `title` names it).
model AttendanceSession {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  date      DateTime
  title     String?
  createdAt DateTime @default(now())

  records  AttendanceRecord[]
  homework ExtraHomework[]

  @@index([courseId, date])
}

model AttendanceRecord {
  sessionId String
  studentId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  // Teacher-only remark; never sent to the student.
  note      String?
  updatedAt DateTime          @updatedAt

  @@id([sessionId, studentId])
}

// Homework given at a meeting outside the site's assignments, checked off by hand.
model ExtraHomework {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime          @default(now())

  marks HomeworkMark[]
}

model HomeworkMark {
  homeworkId String
  studentId  String
  homework   ExtraHomework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  done       Boolean

  @@id([homeworkId, studentId])
}

// A student with personal access to a course (not through its group) whom the
// teacher chose to leave off that course's attendance.
model AttendanceExclusion {
  courseId  String
  studentId String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([courseId, studentId])
}
