# Database
DATABASE_URL=postgresql://user:pass@postgres:5432/homework_db
DIRECT_URL=

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=replace_with_random_64_char_string
JWT_REFRESH_SECRET=replace_with_different_random_64_char_string

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://yourdomain.com/api/auth/github/callback
# Optional: repo checks and AI code fetching already authenticate with the OAuth
# app's client ID/secret above. Set a personal access token here only to override that.
GITHUB_TOKEN=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# OAuth — Frontend redirect after OAuth
OAUTH_SUCCESS_REDIRECT=https://yourdomain.com/auth/callback

# AI (Google Gemini) — one provider for both homework review and quiz generation.
# Google retires model ids; gemini-2.0-flash already returns 404. List what your
# key can use with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=<KEY>"
# Billing belongs to a Google Cloud project and a key inherits it, so:
#   GEMINI_API_KEY      — key of a project WITHOUT billing (free tier).
#   GEMINI_API_KEY_PAID — optional key of a project WITH billing. Used only while
#     the free daily quota is spent, until it resets at midnight Pacific time.
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
GEMINI_MODEL=gemini-3.6-flash
# Optional: free requests per day (RPD), shown in the usage report. Without it the
# report shows the limit Google named the last time the free quota ran out.
GEMINI_FREE_DAILY_LIMIT=
# Optional paid-tier prices per 1M tokens, for the cost report only. Empty = the
# built-in gemini-3.6-flash price list; set them when changing GEMINI_MODEL.
GEMINI_PRICE_INPUT_PER_1M=
GEMINI_PRICE_OUTPUT_PER_1M=

# Email (Brevo transactional email over HTTP API)
# We use the Brevo HTTP API instead of SMTP because Render's free tier blocks
# outbound SMTP. Get an API key at https://app.brevo.com/settings/keys/api.
# If BREVO_API_KEY / BREVO_SENDER_EMAIL are left empty, emails are skipped with a
# console warning (dev-friendly no-op).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Teacher Feature

# App
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://yourdomain.com
# The teacher's address — receives student messages, deadline reports and storage alerts
ADMIN_EMAIL=teacher@example.com

