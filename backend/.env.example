# Database
DATABASE_URL=postgresql://user:pass@postgres:5432/homework_db

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=replace_with_random_64_char_string
JWT_REFRESH_SECRET=replace_with_different_random_64_char_string

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://yourdomain.com/api/auth/github/callback

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# OAuth — Frontend redirect after OAuth
OAUTH_SUCCESS_REDIRECT=https://yourdomain.com/auth/callback

# AI (Claude API)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Email (nodemailer over SMTP)
# Works with Gmail using an App Password:
#   1. Enable 2-Step Verification on the Google account (required for App Passwords).
#   2. Create an App Password at https://myaccount.google.com/apppasswords ("Mail" app).
#   3. Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#      SMTP_USER=your address, SMTP_PASS=the 16-character App Password (no spaces).
# If SMTP_HOST is left empty, emails are skipped with a console warning (dev-friendly no-op).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com

# App
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://yourdomain.com
# The teacher's address — receives student messages, deadline reports and storage alerts
ADMIN_EMAIL=teacher@example.com
